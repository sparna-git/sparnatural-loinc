shape:list_rdfslabel_alpha_defaultLang a datasources:SparqlDatasource;
  datasources:queryTemplate shape:query_list_label_alpha_defaultLang;
  datasources:labelProperty rdfs:label .

shape:list_rdfslabel_alpha_defaultLang_with_range a datasources:SparqlDatasource;
  datasources:queryTemplate shape:query_list_label_alpha_defaultLang_with_range;
  datasources:labelProperty rdfs:label .

shape:search_rdfslabel_contains_defaultLang a datasources:SparqlDatasource;
  datasources:queryTemplate shape:query_search_label_contains_defaultLang;
  datasources:labelProperty rdfs:label .

shape:query_list_label_alpha_defaultLang a datasources:SPARQLQuery;
  datasources:queryString """SELECT DISTINCT ?uri ?label
WHERE {
 ?domain $type $domain .
 ?domain $property ?uri .
 OPTIONAL { ?uri $labelPath ?labelLang . FILTER(lang(?labelLang) = $lang) }
 OPTIONAL { ?uri $labelPath ?labelDefaultLang . FILTER(lang(?labelDefaultLang) = $defaultLang) }
 OPTIONAL { ?uri $labelPath ?labelNoLang . FILTER(lang(?labelNoLang) = \"\") }
 BIND(COALESCE(?labelLang, ?labelDefaultLang, ?labelNoLang) AS ?label)
 FILTER(isIRI(?uri))
}
ORDER BY UCASE(STR(?label))
LIMIT 500""" .

shape:query_list_label_alpha_defaultLang_with_range a datasources:SPARQLQuery;
  datasources:queryString """SELECT DISTINCT ?uri ?label
WHERE {
 ?domain $type $domain .
 ?domain $property ?uri .
 ?uri a $range .
 OPTIONAL { ?uri $labelPath ?labelLang . FILTER(lang(?labelLang) = $lang) }
 OPTIONAL { ?uri $labelPath ?labelDefaultLang . FILTER(lang(?labelDefaultLang) = $defaultLang) }
 OPTIONAL { ?uri $labelPath ?labelNoLang . FILTER(lang(?labelNoLang) = \"\") }
 BIND(COALESCE(?labelLang, ?labelDefaultLang, ?labelNoLang) AS ?label)
 FILTER(isIRI(?uri))
}
ORDER BY UCASE(STR(?label))
LIMIT 500""" .

shape:query_search_label_contains_defaultLang a datasources:SPARQLQuery;
  datasources:queryString """SELECT DISTINCT ?uri ?label
WHERE {
 ?domain $type $domain .
 ?domain $property ?uri .
 ?uri $type $range .
 ?uri $labelPath ?label . FILTER(lang(?label) = '' || lang(?label) = $lang || lang(?label) = $defaultLang)
 FILTER(isIRI(?uri))
 FILTER(CONTAINS(LCASE(STR(?label)), LCASE(\"$key\"))) 
 BIND( IF( STRSTARTS(LCASE(STR(?label)), LCASE(\"$key\")),0,9 ) AS ?starts )
} 
ORDER BY ?starts UCASE(STR(?label))
LIMIT 15""" .

